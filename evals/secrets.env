# Secrets for the evaluation fixtures.
# EVERY VALUE HERE IS FAKE. They only work on the local fixture server (evals/fixtures/server.py).
# The card is the well-known public test number 4242 4242 4242 4242; it moves no money anywhere.
# Tasks refer to these values only by name (for example CARD_NUMBER); the harness types the value.

# Mailbox of the agent (webmail at /mail/ needs no password)
MAIL_ADDRESS=agent.tester@example.test

# Leaf & Co shop: the account the agent creates in the sign-up task
SHOP_NAME=Alex Tester
SHOP_EMAIL=agent.tester@example.test
SHOP_PASSWORD=Fake-Shop-Pass-2468

# Leaf & Co shop: an existing, confirmed account (used by the shorter shop tasks)
SHOP_RETURNING_EMAIL=returning.customer@example.test
SHOP_RETURNING_PASSWORD=Fake-Returning-1357

# Payment card (fake test card; only this exact card is accepted by the fixture shop)
CARD_NUMBER=4242 4242 4242 4242
CARD_EXP=12/30
CARD_CVC=123
CARD_NAME=Alex Tester

# Chirp micro-blog
SOCIAL_USERNAME=alex_tester
SOCIAL_PASSWORD=Fake-Chirp-Pass-9753
